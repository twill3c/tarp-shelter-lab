{
  "name": "tarp-shelter-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:gates": "node scripts/check_gates.mjs",
    "verify": "npm run typecheck && npm test && npm run check:gates"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
